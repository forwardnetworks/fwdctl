{
  "type": "object",
  "required": [
    "network_id",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "links",
        "locations",
        "tags",
        "aliases",
        "external",
        "link_overrides",
        "zones"
      ],
      "x-values": {
        "links": "links between devices",
        "locations": "locations (sites)",
        "tags": "device tags",
        "aliases": "named aliases",
        "external": "the internet node, its suggested connections, L3 VPNs",
        "link_overrides": "a snapshot's added and suppressed links; compare_to_snapshot_id diffs two snapshots",
        "zones": "zones defined in the network"
      }
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "compare_to_snapshot_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
