{
  "type": "object",
  "required": [
    "network_id"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "view": {
      "enum": [
        "summary",
        "triage",
        "devices",
        "platforms",
        "changes",
        "exceptions",
        "neighbors",
        "slow",
        "history",
        "logs"
      ],
      "default": "summary"
    },
    "collector_task_id": {
      "type": "string",
      "minLength": 1
    },
    "failure": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "compare_to_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": "view slow: a second snapshot to set beside the one asked about (total device time, parallelism, per-device figures, and per device type and connection)"
    }
  }
}
