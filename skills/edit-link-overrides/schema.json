{
  "type": "object",
  "required": [
    "network_id"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": " (not needed with staged)"
    },
    "add_present": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port1",
          "port2"
        ],
        "additionalProperties": false,
        "properties": {
          "port1": {
            "type": "string",
            "minLength": 1
          },
          "port2": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "remove_present": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port1",
          "port2"
        ],
        "additionalProperties": false,
        "properties": {
          "port1": {
            "type": "string",
            "minLength": 1
          },
          "port2": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "add_absent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port1",
          "port2"
        ],
        "additionalProperties": false,
        "properties": {
          "port1": {
            "type": "string",
            "minLength": 1
          },
          "port2": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "remove_absent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port1",
          "port2"
        ],
        "additionalProperties": false,
        "properties": {
          "port1": {
            "type": "string",
            "minLength": 1
          },
          "port2": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "apply": {
      "type": "boolean",
      "default": false
    },
    "force": {
      "type": "boolean",
      "default": false
    },
    "staged": {
      "type": "boolean",
      "default": false,
      "description": "edit the network-level STAGED overrides (Forward 26.8+): they leave existing snapshots alone and apply to the next snapshot; no snapshot_id needed"
    },
    "backdate_to_snapshot_id": {
      "type": "string",
      "description": "with staged: push the staged overrides onto this snapshot and every one created after it (INVALIDATES them, per Forward's rule); alone, not with link edits; apply needs confirm equal to this id"
    },
    "confirm": {
      "type": "string",
      "description": "staged backdate: the exact backdate_to_snapshot_id, to apply"
    }
  }
}
