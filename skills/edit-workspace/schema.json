{
  "type": "object",
  "required": [
    "network_id"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "create_workspace": {
      "type": "object",
      "required": [
        "name",
        "devices"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "omissions": {
          "type": "array",
          "items": {
            "enum": [
              "CUSTOM_COMMANDS",
              "NQE_CHECKS",
              "PREDEFINED_CHECKS",
              "INTENT_CHECKS"
            ]
          }
        }
      }
    },
    "add_endpoints": {
      "type": "object",
      "required": [
        "endpoints"
      ],
      "additionalProperties": false,
      "properties": {
        "from_network": {
          "type": "string",
          "minLength": 1
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "credential_id": {
                "type": "string",
                "minLength": 1
              },
              "profile_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "delete_workspace": {
      "type": "boolean"
    },
    "confirm_name": {
      "type": "string",
      "minLength": 1
    },
    "apply": {
      "type": "boolean",
      "default": false
    }
  }
}
