{
  "type": "object",
  "required": ["network_id"],
  "additionalProperties": false,
  "properties": {
    "network_id": { "type": "string", "minLength": 1 },
    "change_set_id": { "type": "string", "minLength": 1 },
    "view": { "enum": ["verify", "describe", "impact", "verdict"], "default": "verify" },
    "run_predict": { "type": "boolean" },
    "connectivity_timeout_seconds": { "type": "integer", "minimum": 1 },
    "device": { "type": "string", "minLength": 1 },
    "before_snapshot_id": { "type": "string", "minLength": 1 },
    "after_snapshot_id": { "type": "string", "minLength": 1 },
    "expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dst_ip", "expect"],
        "additionalProperties": false,
        "properties": {
          "src_ip": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "dst_ip": { "type": "string", "minLength": 1 },
          "protocol": { "type": ["string", "integer"] },
          "src_port": { "type": "string" },
          "dst_port": { "type": "string" },
          "expect": { "enum": ["delivered", "blocked"] }
        }
      }
    }
  }
}
