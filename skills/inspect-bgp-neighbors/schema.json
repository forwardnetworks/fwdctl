{
  "type": "object",
  "required": [
    "network_id"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "vrf": {
      "type": "string",
      "minLength": 1
    },
    "peer": {
      "type": "string",
      "minLength": 1
    },
    "peer_as": {
      "type": "integer",
      "minimum": 1
    },
    "unmodelled_only": {
      "type": "boolean",
      "default": false
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "skip_adj_rib_out": {
      "type": "boolean",
      "default": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "advertised": {
      "type": "object",
      "description": "list the prefixes device advertises to peer (needs device and peer; vrf for a non-default VRF) as a paged list instead of neighbor rows; outside: CIDR blocks, keep only prefixes not inside any of them; direction: out (default) or in, where in lists what the device RECEIVED from the peer (Adj-RIB-In after input policy: every prefix with next hop, local preference and AS path), for choosing a prefix to withdraw",
      "properties": {
        "outside": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "enum": [
            "out",
            "in"
          ],
          "default": "out"
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Forward's routing app as a read (a different question from advertised; give one): where a BGP prefix comes from, who accepts or rejects it, how it propagated and why. view search (default): origin and devices by outcome; trace: propagation paths to routing.router (origin and outcome are taken from a search when absent); details: attributes and policies at one hop of a trace (path, hop); device: what routing.device received and installed for the prefix, per VRF; installed: prefixes installed on routing.device or routing.vendors. A preview route; needs the network ADMIN role (BGP_PREFIX_SEARCH).",
      "properties": {
        "view": {
          "enum": [
            "search",
            "trace",
            "details",
            "device",
            "installed"
          ],
          "default": "search"
        },
        "prefix": {
          "type": "string",
          "description": "CIDR, required except for view installed"
        },
        "router": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device"
          ],
          "properties": {
            "device": {
              "type": "string"
            },
            "vrf": {
              "type": "string"
            }
          }
        },
        "originated_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device"
          ],
          "properties": {
            "device": {
              "type": "string"
            },
            "vrf": {
              "type": "string"
            }
          }
        },
        "outcome": {
          "type": "string"
        },
        "path": {
          "type": "integer",
          "minimum": 0
        },
        "hop": {
          "type": "integer",
          "minimum": 0
        },
        "device": {
          "type": "string"
        },
        "vendors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "lowercase vendor-OS names such as cisco_ios"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
