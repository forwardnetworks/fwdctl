{
  "type": "object",
  "required": [
    "network_id",
    "action",
    "devices",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "add",
        "remove"
      ]
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshot_id": {
      "type": "string",
      "description": "The snapshot the change takes effect from and membership is read at. Omitted: the newest processed snapshot, so NQE shows the tag on it at once (later snapshots inherit it). \"staging\": no snapshot, the change starts after every existing snapshot (the devices must be collection sources)."
    },
    "apply": {
      "type": "boolean",
      "default": false
    }
  }
}
