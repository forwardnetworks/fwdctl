{
  "type": "object",
  "required": ["network_id"],
  "additionalProperties": false,
  "properties": {
    "network_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "cve_id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
    "device": { "type": "string", "minLength": 1 },
    "min_severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "known_exploited_only": { "type": "boolean" },
    "internet_addressable": { "type": "boolean" },
    "limit": { "type": "integer", "minimum": 1 }
  }
}
