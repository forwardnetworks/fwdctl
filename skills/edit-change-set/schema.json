{
  "type": "object",
  "required": [
    "network_id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device",
          "commands"
        ],
        "additionalProperties": false,
        "properties": {
          "device": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": [
              "string",
              "array"
            ],
            "minLength": 1,
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "the CLI text to stage: one string (lines separated by newlines) or an array of lines, joined with newlines"
          }
        }
      }
    },
    "bgp_advertisements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device",
          "external_peer",
          "prefix"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "inject",
              "modify",
              "withdraw",
              "restore"
            ],
            "default": "inject",
            "description": "inject or modify: stage an advertisement (next_hop required); withdraw: stage the loss of a received one (device, vrf, external_peer, prefix only); restore: drop what is staged for the key. type is the peer type (EBGP or IBGP), not the action"
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "vrf": {
            "type": "string"
          },
          "external_peer": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "minLength": 1
          },
          "next_hop": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "local_pref": {
            "type": "integer"
          },
          "as_path": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "med": {
            "type": "integer"
          },
          "communities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "run": {
      "type": "boolean",
      "default": false
    },
    "apply": {
      "type": "boolean",
      "default": false
    },
    "firewall_rules": {
      "type": "array",
      "description": "firewall rule changes to stage: {op: add|remove, device, scope_id (default LOCAL), rulebase_id (default PRIMARY), predecessor (add: the rule to go after), rule_id (remove), rule (add: name, action, enabled, sourceZones, destinationZones, sourceAddresses, destinationAddresses, sourceUsers, applications, services)}",
      "items": {
        "type": "object",
        "required": [
          "op",
          "device"
        ]
      }
    }
  }
}
