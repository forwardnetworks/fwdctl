{
  "type": "object",
  "required": [
    "network_id"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "create_profile": {
      "type": "object",
      "required": [
        "name",
        "copy_from",
        "add_oids"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "copy_from": {
          "type": "string",
          "minLength": 1
        },
        "add_oids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "oid"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "oid": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)+$"
              }
            }
          }
        }
      }
    },
    "assign": {
      "type": "object",
      "required": [
        "endpoints",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "1 to 20 endpoint names of this network"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delete_profile": {
      "type": "string",
      "minLength": 1
    },
    "apply": {
      "type": "boolean",
      "default": false
    }
  }
}
