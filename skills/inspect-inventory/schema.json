{
  "type": "object",
  "required": [
    "network_id",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "summary",
        "devices",
        "interfaces",
        "vlans",
        "vrfs",
        "hosts",
        "cloud_accounts",
        "cloud",
        "cloud_routes",
        "cloud_security",
        "cloud_gateways",
        "ip_owner",
        "cloud_subnets",
        "cloud_instances",
        "routes",
        "igp_neighbors",
        "security_rules_experimental"
      ]
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "ips": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "kind ip_owner, required: the IPv4 addresses whose owning interface to find"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "compare_to_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": "kind devices: another snapshot to compare with; lists the devices added and removed since it, with counts by vendor, type and name prefix"
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "description": "kinds devices and security_rules_experimental: only this vendor (Forward's vendor name, case-insensitive, such as FORTINET or CISCO)"
    }
  }
}
