   "should_trigger": true,
   "expected_behavior": [
    "uses investigate-reachability from internet",
    "states how the internet is modelled"
   ]
  },
  {
   "query": "Are we secure?",
   "should_trigger": true,
   "expected_behavior": [
    "does not claim clean from absence of findings",
