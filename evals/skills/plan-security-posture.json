   ]
  },
  {
   "query": "Is CVE-2024-3400 relevant to us?",
   "should_trigger": false,
   "note": "plan-vulnerability-response"
  },
  {
   "query": "Does anything violate our NTP policy?",
   "should_trigger": false,
   "note": "check-network-compliance"
  },
  {
